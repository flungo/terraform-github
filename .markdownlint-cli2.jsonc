// markdownlint rules for this repo, consumed by the markdown-lint workflow
// (flungo/github-workflows). Standard defaults per that repo's
// docs/reference/markdown-validation.md; add further overrides only with an
// inline justification.
{
  "config": {
    // Disabled in favour of the semantic line breaks convention (one sentence
    // per source line) — a character ceiling can't reflow and would fight it.
    "MD013": false,
    // Allow repeated subsection names under different parents (e.g. Context /
    // Decision / Consequences across ADRs); paired with the unique-heading
    // convention for anything cross-referenced.
    "MD024": { "siblings_only": true },
    // Compact tables, one space each side of every pipe. Pinned rather than
    // left to MD060's ambiguous default ("consistent" infers per table, and
    // picks "aligned" where no row disambiguates). Same reasoning as MD013
    // above: a diff should be the size of the change. Under "aligned" cell
    // width is shared state — every cell is padded to its column's widest, so
    // one edit reflows the whole table and one long cell taxes every row.
    "MD060": { "style": "compact" },
    // Repo-specific, and the only override beyond the three standard ones:
    // <details>/<summary> is a GitHub rendering affordance with no Markdown
    // equivalent, used to fold an optional fallback procedure out of a
    // runbook's main path. Only those two elements are allowed — every other
    // inline HTML element stays flagged.
    "MD033": { "allowed_elements": ["details", "summary"] }
  },
  // A local `terraform init` writes provider source under owners/<owner>/
  // .terraform/, and some providers ship a README. That directory is
  // gitignored, but markdownlint does not read .gitignore — so without this a
  // local run reports findings in vendored files that CI (a fresh checkout,
  // never inited) cannot see, which is the wrong way round for a check meant
  // to catch things before CI does.
  "ignores": [
    "**/.terraform/**"
  ]
}
